{
  "name": "release-automation-actions",
  "version": "0.0.1",
  "private": true,
  "description": "The GitHub actions of the release automation, written for Node 24 so they can also run locally",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write 'src/**/*.js' 'test/**/*.js' 'scripts/**/*.mjs'",
    "check": "prettier --check 'src/**/*.js' 'test/**/*.js' 'scripts/**/*.mjs'",
    "compile": "node scripts/compile.mjs",
    "build": "npm run format && npm run compile",
    "test": "vitest run"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@octokit/rest": "^22.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@vercel/ncc": "0.45.0",
    "prettier": "3.9.10",
    "vitest": "^5.0.0"
  }
}
